{
  "name": "@invezgo/openclaw-plugin-invezgo",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "plugin:build": "npm run build && openclaw plugins build --entry ./dist/index.js",
    "plugin:validate": "npm run build && openclaw plugins validate --entry ./dist/index.js",
    "test": "vitest run --config ./vitest.config.ts",
    "gen": "node scripts/gen-catalog.mjs"
  },
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "peerDependencies": {
    "openclaw": ">=2026.5.17"
  },
  "dependencies": {
    "typebox": "^1.1.38"
  },
  "devDependencies": {
    "openclaw": "2026.11.3",
    "typescript": "7.0.2",
    "vitest": "^3.2.0"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.5.17"
    },
    "build": {
      "openclawVersion": "2026.11.3"
    }
  },
  "description": "OpenClaw plugin for the Invezgo API: Indonesia Stock Exchange (IDX) market data, broker flow, shareholders, financials and screener.",
  "license": "MIT",
  "homepage": "https://invezgo.com",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "invezgo",
    "idx",
    "bei",
    "saham",
    "stocks",
    "indonesia"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Invezgo/invezgo-claw.git"
  },
  "bugs": {
    "url": "https://github.com/Invezgo/invezgo-claw/issues"
  }
}
